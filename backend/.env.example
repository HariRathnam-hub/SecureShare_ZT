NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=
# Exact frontend origin (no trailing slash). Used for CORS and email links.
CLIENT_URL=http://localhost:5173

# Generate each: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# Email via Brevo API (https://app.brevo.com > SMTP & API > API keys).
# Optional in development: when empty, verification/reset links are printed to the console.
# REQUIRED in production.
BREVO_API_KEY=
EMAIL_FROM_NAME=SecureShare ZT
# Must be a sender verified in your Brevo account.
EMAIL_FROM_ADDRESS=

# File storage. "local" writes to UPLOAD_DIR on this server's disk.
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

# Used only by `npm run seed:admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Phase 3 (all optional; leave blank for plain local development)
# ---------------------------------------------------------------------------
# Extra exact origins CORS should accept besides CLIENT_URL, comma separated, no trailing slash.
# Tunnel demo: CLIENT_URL=<your trycloudflare URL> and ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_ORIGINS=
# Reverse proxies in front of the API. 1 = Render/most hosts, 0 = none (plain localhost),
# 2 = Quick Tunnel demo (cloudflared -> Vite proxy -> API) so req.ip is the real client address.
TRUST_PROXY_HOPS=1
# Informational only: the Quick Tunnel URL you started by hand. The dashboard shows it as "manually configured".
TUNNEL_PUBLIC_URL=

# Cloudflare Access. Leave false until an Access application exists for your hostname (see README).
CLOUDFLARE_ACCESS_ENABLED=false
# Your Zero Trust team domain, e.g. myteam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) tag copied from the Access application (a long hex string)
CF_ACCESS_AUD=

# ---------------------------------------------------------------------------
# Security hardening
# ---------------------------------------------------------------------------
# Cloudflare Turnstile SECRET key (dashboard > Turnstile > your widget). Server-side only: never put it in the frontend,
# a VITE_* variable, or Git. REQUIRED when NODE_ENV=production (the server refuses to boot without it, and refuses
# Cloudflare's dummy test secrets). In development, leave empty to skip the check, or use the dummy secret
# 1x0000000000000000000000000000000AA (always passes) with the dummy site key.
TURNSTILE_SECRET_KEY=
# Optional: hostnames Turnstile may report, comma separated. Default: the hostnames of CLIENT_URL + ALLOWED_ORIGINS.
TURNSTILE_EXPECTED_HOSTNAMES=

# Where rate-limit counters live: "memory" (default; per process, reset on restart and Render spin-down) or "mongo"
# (shared across instances and restarts; uses the 'ratelimits' collection in MONGODB_URI).
RATE_LIMIT_STORE=memory

# Real client IP source. Leave EMPTY to use X-Forwarded-For with TRUST_PROXY_HOPS. On Render set it to cf-connecting-ip ONLY
# after running the verification steps in docs/SECURITY-HARDENING.md (section 2). Accepted: cf-connecting-ip, true-client-ip.
CLIENT_IP_HEADER=

# Optional origin lock, for when the API is served through a proxied Cloudflare hostname (docs section 5). When set, every
# request except /health must send X-Origin-Verify: <this value> (added by a Cloudflare Transform Rule). >= 32 random chars.
# Do NOT set it while browsers still call the *.onrender.com URL directly: the app would stop working.
ORIGIN_VERIFY_SECRET=

# PRODUCTION (Render) CORS reminder: CLIENT_URL=https://secureshare-zt.pages.dev and leave ALLOWED_ORIGINS empty. Production
# accepts only exact https origins (no localhost, no paths).
