# Leave empty for local development AND for Cloudflare Quick Tunnel demos: the browser calls /api on its own origin
# and Vite proxies it to the backend (see vite.config.ts). Never put secrets in any VITE_* variable; they are public.
#
# Only for a separately hosted API (e.g. Render): VITE_API_URL=https://your-api.onrender.com/api/v1
VITE_API_URL=

# Optional: extra Host header Vite should accept (e.g. a named Cloudflare Tunnel hostname). Read by vite.config.ts at start-up.
# VITE_ALLOWED_HOST=app.example.com

# Cloudflare Turnstile PUBLIC site key (safe to expose; the secret key is a BACKEND variable only).
# Production build (Cloudflare Pages): REQUIRED. Without it the login/register/reset forms refuse to submit.
# Local development: leave empty (the backend then skips verification) or use Cloudflare's dummy key 1x00000000000000000000AA
# together with the dummy backend secret 1x0000000000000000000000000000000AA. Never use dummy keys in production.
VITE_TURNSTILE_SITE_KEY=
