# Cloudflare Pages response headers for https://secureshare-zt.pages.dev (copied from /public into the build output).
# Applies to the static frontend only. It does NOT protect the API on Render.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  # Report-Only on purpose: it could not be tested in a browser here. Open the site, check the console for violations,
  # then rename the header to Content-Security-Policy to enforce it. Update connect-src if the API URL changes.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self' https://secureshare-zt.onrender.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
